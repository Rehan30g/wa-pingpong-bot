# Salin menjadi .env, lalu ganti nilai placeholder.
OPENROUTER_API_KEY=GANTI_DENGAN_OPENROUTER_API_KEY

# Model pengambil keputusan dan model penulis jawaban.
JEV_MODEL=typesafe/jev-1.13
CHAT_MODEL=z-ai/glm-5.3-flash
GLM_REASONING_EFFORT=low

# Identitas bot di dalam percakapan grup.
BOT_NAME=GANTI_NAMA_BOT
BOT_ROLE=asisten grup yang ramah, ringkas, dan membantu saat ditanya

# VPS pada AGENTS.md memerlukan proxy ini untuk OpenRouter.
# Kosongkan jika mesin Anda dapat mengakses OpenRouter secara langsung.
OPENROUTER_PROXY_URL=http://127.0.0.1:8118
OPENROUTER_HTTP_REFERER=https://github.com/Rehan30g/wa-pingpong-bot
OPENROUTER_APP_NAME=WA Group Agent

# Penyetelan perilaku.
AI_HISTORY_LIMIT=24
# Jumlah media terbaru dalam riwayat aktif yang tetap dikirim ulang ke GLM.
AI_HISTORY_MEDIA_LIMIT=4
AI_DEBOUNCE_MS=1200
AI_COMPACT_TRIGGER=18
AI_COMPACT_RETAIN=6
AI_MEMORY_FILE=./ai-memory.json
AI_REPLY_CONFIDENCE=0.55
AI_REACT_CONFIDENCE=0.70
AI_DIRECT_REACT_CONFIDENCE=0.30
AI_MAX_REPLY_CHARS=220

# --- Agen & chat pribadi (DM) ---
# Grad hanya boleh membalas/memulai DM ke nomor yang pernah mengirim pesan di grup.
AI_AGENT_ENABLED=true
# Izinkan Grad memulai DM proaktif (tetap dibatasi whitelist, jam tenang, cooldown, kuota harian).
AI_AGENT_PROACTIVE=true
AI_AGENT_TICK_MS=60000
AI_AGENT_DAILY_PROACTIVE_LIMIT=5
AI_AGENT_PERSON_COOLDOWN_HOURS=20
AI_AGENT_ACTIVE_DAYS=7
# Jam tenang WIT: bot tidak memulai DM proaktif pada rentang ini.
AI_AGENT_QUIET_START=22
AI_AGENT_QUIET_END=7
AGENT_JOBS_FILE=./agent-jobs.json

AI_DM_DEBOUNCE_MS=700
# Jev harus seyakin ini sebelum Grad mengabaikan pesan DM.
AI_DM_IGNORE_CONFIDENCE=0.7
AI_DM_MIN_DELAY_MS=500
AI_DM_MAX_DELAY_MS=2200
# Skala jeda natural (0 = instan, untuk simulasi/tes).
AI_HUMAN_DELAY_SCALE=1

# Opsional: lokasi data bot.
# BOT_DATA_FILE=./data.json
# Batas ukuran gambar/video yang dikirim ke GLM (MB).
AI_MAX_MEDIA_MB=20

# "Telinga" Grad: model audio (di-pin, jangan alias ~latest) dan batas durasi audio.
AUDIO_MODEL=google/gemini-3.1-flash-lite
# Dipakai otomatis bila model utama error/output rusak. Kosongkan untuk mematikan.
AUDIO_FALLBACK_MODEL=xiaomi/mimo-v2.6-flash
# off = tanpa thinking (paling cepat). Model yang mewajibkan thinking otomatis turun ke minimal.
AUDIO_REASONING_EFFORT=off
AI_MAX_AUDIO_SEC=300
AI_MAX_AUDIO_MB=16
# Jumlah voice note terbaru per chat yang audionya disimpan di memori untuk listen_audio.
AI_HISTORY_AUDIO_LIMIT=3

# --- Agent loop (M1): GLM + tools ---
# Batas per tugas: langkah (tool call), waktu, dan biaya.
AGENT_MAX_STEPS=25
AGENT_TASK_TIMEOUT_MS=180000
AGENT_TASK_BUDGET_USD=0.15
# Setelah budget harian habis, Grad tetap membalas tetapi tanpa tools.
AGENT_DAILY_BUDGET_USD=3
# Web search bawaan OpenRouter (server tool openrouter:web_search).
AGENT_WEB_SEARCH=true
AGENT_WEB_SEARCH_RESULTS=5
# Pesan progres ("bentar ya") bila tugas terasa lama, dan pesan kedua untuk tugas >60 detik.
AGENT_PROGRESS_AFTER_MS=20000
# Setelah tool lambat (python, fetch, edit media) dipanggil, progres paling cepat di detik ke-:
AGENT_TOOL_PROGRESS_AFTER_MS=12000
AGENT_LONG_PROGRESS_AFTER_MS=60000
# Panjang maksimum jawaban tugas yang memakai tools (obrolan biasa tetap AI_MAX_REPLY_CHARS).
AI_MAX_TASK_REPLY_CHARS=1500

# Koleksi stiker Grad: kandidat + database SQLite (folder ini di-ignore Git).
STICKER_DIR=./data/stickers
# Kapasitas koleksi dan rem pemakaian (per chat per jam).
STICKER_CAPACITY=150
STICKER_MAX_PER_HOUR=4
# Peluang reaction (😂/👍/❤️/😮) diganti stiker koleksi dengan mood yang cocok.
STICKER_REACTION_CHANCE=0.5
# Kurasi harian: batch gambar per panggilan GLM dan jumlah batch maksimum per hari.
STICKER_CURATION_BATCH=10
STICKER_CURATION_MAX_BATCHES=3
# Stiker yang di-skip dinilai ulang bila dipakai manusia ≥N kali lagi; skip basi dihapus setelah N hari.
STICKER_SKIP_RECHECK_USES=3
STICKER_PURGE_DAYS=30
STICKER_REVIEW_DAYS=7

# --- Runtime Durable & Storage (Fase 2) ---
# Engine mode: legacy | shadow | agent (default: legacy)
RUNTIME_ENGINE_MODE=legacy
# Path file database SQLite (otomatis di-ignore Git)
RUNTIME_DB_PATH=./runtime.db
# Pengaturan worker, lease dan outbox
RUNTIME_WORKER_ID=worker-default
RUNTIME_LEASE_DURATION_MS=30000
RUNTIME_OUTBOX_DRAIN_INTERVAL_MS=5000

# Web fetch agen hanya aktif bila owner mengisi allowlist host HTTPS eksplisit.
AGENT_WEB_FETCH_ENABLED=false
AGENT_WEB_SEARCH_ENABLED=false
AGENT_MEMORY_FACTS_ENABLED=false
AGENT_WEB_ALLOWED_HOSTS=
# Unduh gambar dari URL hanya aktif dengan allowlist host HTTPS eksplisit.
AGENT_MEDIA_URL_ENABLED=false
AGENT_MEDIA_ALLOWED_HOSTS=
# Baca asset gambar dari pesan yang sama dengan task; nonaktif default.
AGENT_MESSAGE_MEDIA_ENABLED=false
# Pembuatan stiker dan pengiriman asset dinyalakan terpisah setelah gate lokal/shadow/canary.
AGENT_MAKE_STICKER_ENABLED=false
AGENT_SEND_ASSET_ENABLED=false
# Asset sementara terisolasi; kosong menggunakan direktori temp OS.
# RUNTIME_ASSET_DIR=./runtime-assets
# Shadow memakai root asset terpisah dari agent.
# RUNTIME_SHADOW_ASSET_DIR=./runtime-shadow-assets

# --- Proaktif di grup (M5) ---
# Jev memberi sinyal opportunity: help (bantuan nyata) atau social (nimbrung).
AGENT_PROACTIVE_CONFIDENCE=0.6
AGENT_HELP_COOLDOWN_MIN=2
AGENT_SOCIAL_COOLDOWN_MIN=20
AGENT_SOCIAL_MAX_PER_HOUR=2
# "grad diem dulu" → jalur proaktif mati selama N jam.
AGENT_SOCIAL_MUTE_HOURS=3
# Variasi nama panggilan bot selain BOT_NAME (dipisah koma). Huruf berulang ("Gradd") sudah otomatis.
# BOT_NAME_ALIASES=

# Memori & catatan (M4)
# NOTEBOOK_FILE=./data/notebook.json

# --- Python sandbox (M4b, Pyodide tanpa Docker) ---
# Siapkan sekali: npm run python:setup (unduh paket ke PYTHON_CACHE_DIR).
# Fitur "python" aktif default; owner bisa mengunci: /fitur global python kunci
# PYTHON_CACHE_DIR=./data/pyodide-cache
# WORKSPACE_DIR=./data/workspace
PYTHON_TIMEOUT_MS=60000
PYTHON_MEMORY_MB=768
PYTHON_MAX_REQUESTS=20
WORKSPACE_MAX_MB=50

# --- Tugas latar (subagent) ---
AGENT_BACKGROUND_MAX_STEPS=40
AGENT_BACKGROUND_TIMEOUT_MS=900000
AGENT_BACKGROUND_BUDGET_USD=0.5
AGENT_BACKGROUND_MAX_PER_CHAT=2
AGENT_BACKGROUND_MAX_PER_DAY=20
# Font untuk teks di video (media_edit). Kosong = cari Arial/DejaVu otomatis.
# MEDIA_FONT_FILE=

# --- Dashboard owner (lokal) ---
# Hanya 127.0.0.1 (akses VPS lewat SSH tunnel). Boleh diisi IP Tailscale; JANGAN IP publik.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=7777
# Token akses (dibuat otomatis). Link: npm run dashboard:link
# DASHBOARD_TOKEN_FILE=./data/dashboard-token
# Pengaturan yang diubah dari dashboard (menimpa .env, bukan secret).
# RUNTIME_SETTINGS_FILE=./data/runtime-settings.json
# Fitur per grup (M2b).
# FEATURES_FILE=./features.json

# --- Skill ---
# Skill tambahan owner (file .md, format sama dengan ai/skills/builtin); nama sama menimpa bawaan.
SKILLS_DIR=./data/skills

# --- Dokumen (PDF/Word/PPT/Excel) ---
# Butuh npm run python:setup (library dokumen). Halaman PDF hasil scan dibaca OCR Gemini.
DOC_MAX_MB=20
DOC_MAX_PAGES=300
DOC_OCR_MODEL=google/gemini-3.1-flash-lite
DOC_OCR_MAX_PAGES=30
DOC_OCR_DAILY_PAGES=300

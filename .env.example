# Salin menjadi .env, lalu ganti nilai placeholder.
OPENROUTER_API_KEY=GANTI_DENGAN_OPENROUTER_API_KEY

# Model pengambil keputusan dan model penulis jawaban.
JEV_MODEL=typesafe/jev-1.13
CHAT_MODEL=z-ai/glm-5.3-flash
GLM_REASONING_EFFORT=low

# Identitas bot di dalam percakapan grup.
BOT_NAME=GANTI_NAMA_BOT
BOT_ROLE=asisten grup yang ramah, ringkas, dan membantu saat ditanya

# VPS pada AGENTS.md memerlukan proxy ini untuk OpenRouter.
# Kosongkan jika mesin Anda dapat mengakses OpenRouter secara langsung.
OPENROUTER_PROXY_URL=http://127.0.0.1:8118
OPENROUTER_HTTP_REFERER=https://github.com/Rehan30g/wa-pingpong-bot
OPENROUTER_APP_NAME=WA Group Agent

# Penyetelan perilaku.
AI_HISTORY_LIMIT=24
# Jumlah media terbaru dalam riwayat aktif yang tetap dikirim ulang ke GLM.
AI_HISTORY_MEDIA_LIMIT=4
AI_DEBOUNCE_MS=1200
AI_COMPACT_TRIGGER=18
AI_COMPACT_RETAIN=6
AI_MEMORY_FILE=./ai-memory.json
AI_REPLY_CONFIDENCE=0.55
AI_REACT_CONFIDENCE=0.70
AI_DIRECT_REACT_CONFIDENCE=0.30
AI_MAX_REPLY_CHARS=220

# --- Agen & chat pribadi (DM) ---
# Grad hanya boleh membalas/memulai DM ke nomor yang pernah mengirim pesan di grup.
AI_AGENT_ENABLED=true
# Izinkan Grad memulai DM proaktif (tetap dibatasi whitelist, jam tenang, cooldown, kuota harian).
AI_AGENT_PROACTIVE=true
AI_AGENT_TICK_MS=60000
AI_AGENT_DAILY_PROACTIVE_LIMIT=5
AI_AGENT_PERSON_COOLDOWN_HOURS=20
AI_AGENT_ACTIVE_DAYS=7
# Jam tenang WIT: bot tidak memulai DM proaktif pada rentang ini.
AI_AGENT_QUIET_START=22
AI_AGENT_QUIET_END=7
AGENT_JOBS_FILE=./agent-jobs.json

AI_DM_DEBOUNCE_MS=700
# Jev harus seyakin ini sebelum Grad mengabaikan pesan DM.
AI_DM_IGNORE_CONFIDENCE=0.7
AI_DM_MIN_DELAY_MS=500
AI_DM_MAX_DELAY_MS=2200
# Skala jeda natural (0 = instan, untuk simulasi/tes).
AI_HUMAN_DELAY_SCALE=1

# Opsional: lokasi data bot.
# BOT_DATA_FILE=./data.json
# Batas ukuran gambar/video yang dikirim ke GLM (MB).
AI_MAX_MEDIA_MB=20
